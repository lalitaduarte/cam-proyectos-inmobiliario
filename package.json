{
  "name": "cam-proyectos-inmobiliario",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación web de CAM Proyectos Inmobiliario SAS: semanas, adquisiciones, pagos, comprobantes y comunidad.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"pruebas/api/*.test.js\"",
    "test:navegador": "node --env-file-if-exists=.env --test --test-concurrency=1 pruebas/navegador/recorrido.test.js",
    "test:volumen": "node --env-file-if-exists=.env --test --test-concurrency=1 pruebas/volumen/volumen.test.js",
    "respaldar": "node --env-file-if-exists=.env scripts/respaldar.js",
    "probar-restauracion": "node --env-file-if-exists=.env scripts/probar_restauracion.js",
    "persistencia": "node --env-file-if-exists=.env scripts/persistencia.js",
    "diccionario": "node --env-file-if-exists=.env scripts/diccionario.js",
    "bd:instalar": "node --env-file-if-exists=.env scripts/instalar_bd.js",
    "crear-secretaria": "node --env-file-if-exists=.env scripts/crear_secretaria.js",
    "neon:instalar": "node --env-file-if-exists=.env scripts/instalar_neon.js",
    "neon:crear-secretaria": "node --env-file-if-exists=.env scripts/crear_secretaria.js --neon",
    "neon:respaldar": "node --env-file-if-exists=.env scripts/respaldar.js --neon"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  }
}
