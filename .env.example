# ============================================================
# Plantilla de configuración de CAM (SIN secretos).
# Copie este archivo como .env y reemplace los valores de ejemplo.
# El archivo .env NUNCA se sube al repositorio.
# ============================================================

# Contraseña del superusuario "postgres" local. Solo para el script 00 (crear base y roles).
PG_SUPERUSER_PASSWORD=escriba_aqui_la_clave_de_postgres

# --- Base de datos local (PostgreSQL 18) ---
PGHOST=localhost
PGPORT=5436
CAM_DB=cam_db
CAM_TEST_DB=cam_test
CAM_ADMIN_USER=cam_admin
CAM_ADMIN_PASSWORD=cambie_esta_clave_admin
CAM_APP_USER=cam_app
CAM_APP_PASSWORD=cambie_esta_clave_app

# Carpeta de las herramientas de PostgreSQL 18 (psql, pg_dump, pg_restore). Opcional.
# PG_BIN=C:\Program Files\PostgreSQL\18\bin

# --- Publicación (Neon) ---
# Cadena de conexión del DUEÑO del proyecto Neon (neondb_owner), copiada de la consola de Neon.
# Solo la usa npm.cmd run neon:instalar. Las tres líneas NEON_* siguientes las escribe ese comando.
# NEON_OWNER_URL=postgresql://neondb_owner:CLAVE@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# NEON_CAM_ADMIN_PASSWORD=(generada)
# NEON_CAM_APP_PASSWORD=(generada)
# NEON_DATABASE_URL=(generada: es el valor de DATABASE_URL que se configura en Render)
#
# DATABASE_URL: si existe, el backend la usa en lugar de la base local. NO la active en el
# .env local (la aplicación local quedaría conectada a la base publicada).
# DATABASE_URL=postgresql://cam_app:CLAVE@HOST.neon.tech/cam_db?sslmode=require

# --- Aplicación ---
PORT=3100
SESSION_SECRET=cadena_larga_y_aleatoria
